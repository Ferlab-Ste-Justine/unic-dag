{
  "concurrency": 1,
  "schedule": null,
  "timeout_hours": 4,
  "steps": [
    {
      "destination_zone": "yellow",
      "destination_subzone": "enriched",
      "main_class": "bio.ferlab.ui.etl.yellow.enriched.trajectoireobesite.Main",
      "multiple_main_methods": true,
      "datasets": [
        {"dataset_id": "enriched_trajectoireobesite_participant_index", "cluster_type": "medium", "run_type": "default", "pass_date": true, "dependencies": []},
        {"dataset_id": "enriched_trajectoireobesite_diagnostic"       , "cluster_type": "medium", "run_type": "default", "pass_date": true, "dependencies": ["enriched_trajectoireobesite_participant_index"]},
        {"dataset_id": "enriched_trajectoireobesite_growth"           , "cluster_type": "medium", "run_type": "default", "pass_date": true, "dependencies": ["enriched_trajectoireobesite_participant_index"]},
        {"dataset_id": "enriched_trajectoireobesite_laboratory_result", "cluster_type": "medium", "run_type": "default", "pass_date": true, "dependencies": ["enriched_trajectoireobesite_participant_index"]},
        {"dataset_id": "enriched_trajectoireobesite_risk_factor"      , "cluster_type": "medium", "run_type": "default", "pass_date": true, "dependencies": ["enriched_trajectoireobesite_participant_index"  , "enriched_trajectoireobesite_diagnostic", "enriched_trajectoireobesite_growth", "enriched_trajectoireobesite_laboratory_result"]}
      ]
    },
    {
      "destination_zone": "green",
      "destination_subzone": "released",
      "main_class": "bio.ferlab.ui.etl.released.Main",
      "multiple_main_methods": false,
      "datasets": [
        {"dataset_id": "released_trajectoireobesite_diagnostic"       , "cluster_type": "small", "run_type": "default", "pass_date": true, "dependencies": []},
        {"dataset_id": "released_trajectoireobesite_growth"           , "cluster_type": "small", "run_type": "default", "pass_date": true, "dependencies": []},
        {"dataset_id": "released_trajectoireobesite_laboratory_result", "cluster_type": "small", "run_type": "default", "pass_date": true, "dependencies": []},
        {"dataset_id": "released_trajectoireobesite_risk_factor"      , "cluster_type": "small", "run_type": "default", "pass_date": true, "dependencies": []}
      ]
    }
  ]
}